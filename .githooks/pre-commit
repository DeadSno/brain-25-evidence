#!/bin/sh
# brain-25-evidence: pre-commit hook
# ?????? pytest ??? network-??????. ???? ??????? ? ?????? ??????????.
# ??????: git commit --no-verify

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

# ???? python ? venv (Windows ??? Unix), fallback ? ?????????
PY=""
for candidate in ".venv/Scripts/python.exe" ".venv/bin/python" "python3" "python"; do
    if command -v "$candidate" >/dev/null 2>&1 || [ -x "$candidate" ]; then
        PY="$candidate"
        break
    fi
done

if [ -z "$PY" ]; then
    echo "pre-commit: python ?? ??????, ????????? ?????"
    exit 0
fi

# snapshot_data (tests/test_snapshot.py) ИСКЛЮЧЁН намеренно. Тест сравнивает
# слепок docs/data.json с самим data.json, а hook смотрит рабочее дерево —
# то есть любое осознанное обновление данных (build_key_sources.py и подобные)
# блокировало коммит и требовало сначала переснять слепок, а потом менять данные
# либо смешивать и то и другое в одном коммите. Замерено 2026-10-07.
# Тест НЕ выключен: он остаётся в `pytest -q` и в CI, где и должен ловить
# незаметную мутацию данных. Вне hook он — гейт, внутри hook — тупик.
# --- sitemap (v5.6.1, 2026-10-08) -------------------------------------------
# lastmod в sitemap.xml берётся из `git log` по каждой странице, поэтому любой
# коммит, затронувший docs/*.html, делает закоммиченный sitemap.xml устаревшим:
# генератор начинает считать страницу изменённой с даты этого коммита, а файл
# в репозитории отстаёт на один. Именно на этом упал CI после батча C —
# оба джоба, шаг Sitemap check. Генерируем ДО коммита и добавляем в индекс.
#
# --commit-date обязателен и это не формальность: `git log` не видит
# незакоммиченные правки, поэтому файл из индекса получил бы дату своего
# ПРЕДЫДУЩЕГО коммита. Замерено 2026-10-08 на клоне: генерация дала
# glossary 2026-10-07, а CI после коммита посчитал 2026-10-08 и упал.
#
# Если генератор падает — блокируем коммит. Он выходит только когда
# контентной страницы нет или docs/sup/ пуст, то есть на настоящей поломке
# репозитория. Молча пропустить нельзя: sitemap.xml останется устаревшим
# и push всё равно упрётся в CI.
echo "-> build_sitemap.py --commit-date"
"$PY" scripts/build_sitemap.py --commit-date "$(date +%Y-%m-%d)" || {
    echo ""
    echo "SITEMAP FAILED. docs/sitemap.xml не обновлён, коммит прерван."
    echo "Причина обычно видна в строке выше (нет контентной страницы?)."
    exit 1
}
git add docs/sitemap.xml

# --- junk guard (v5.6.3, 2026-10-10) --------------------------------------
# Диагностические файлы агентов (`_tmp_*`, `_diag_*`, `_baseline_*`) не должны
# попадать в индекс. Замер 2026-10-10: в reports/ их было 71 — около 38 МБ
# PNG и JSON; в docs/ такой файл ломает test_audit_covers_every_page, потому
# что docs/ перебирается как источник страниц.
#
# Проверяется ИНДЕКС (`git ls-files`), а не рабочее дерево. На момент
# pre-commit индекс — это ровно то, что уйдёт в коммит, а локальные
# черновики от него не зависят: их снимает .gitignore, и валить хук они не
# должны. Проверка каталога на диске дала бы 38 ложных срабатываний, пока
# файлы лежат после `git rm --cached`.
#
# Якорь `(^|/)` обязателен: без него `_diag` ловит и
# docs/architecture_diagrams.md, который мусором не является.
echo "-> junk guard (docs/, reports/)"
JUNK="$(git ls-files -- docs reports | grep -E '(^|/)_(tmp|diag|baseline)_' || true)"
if [ -n "$JUNK" ]; then
    echo ""
    echo "JUNK FAILED. В коммит попадают временные файлы:"
    echo "$JUNK" | sed 's/^/  /'
    echo "Сними их с индекса (git rm --cached <файл>) и добавь правило в .gitignore."
    exit 1
fi

# --- feed (v5.6.4, 2026-10-09) -------------------------------------------------
# Причина та же, что у sitemap, и лечится так же. Дата записи каталога
# sup/index.html берётся из `git log`, а карточки читают `updated` из
# data.json. Поэтому ЛЮБОЙ коммит, затронувший docs/sup/index.html, делал
# закоммиченный docs/feed.xml устаревшим на один день, и CI падал на шаге
# «Feed check». Замерено 2026-10-09 на этом коммите: расходились ровно две
# строки — <lastBuildDate> и <pubDate> каталога (08 → 09 Oct), остальные
# 129 карточек совпали до байта.
#
# --commit-date обязателен по той же причине, что в sitemap: файл из индекса
# `git log` не видит и получил бы дату ПРЕДЫДУЩЕГО коммита. Записи каточек
# он не касается — их pubDate из data.json, то есть истории git не касается
# вовсе, и --commit-date на них ничего не меняет.
#
# Генератор падает, если в data.json есть запись без файла карточки или
# карточка без поля `updated`, — это настоящая поломка репозитория, а не
# повод пропустить коммит молча: устаревший фид упрётся в CI иначе.
echo "-> build_feed.py --commit-date"
"$PY" scripts/build_feed.py --commit-date "$(date +%Y-%m-%d)" || {
    echo ""
    echo "FEED FAILED. docs/feed.xml не обновлён, коммит прерван."
    echo "Причина обычно видна в строке выше (запись data.json без карточки?)."
    exit 1
}
git add docs/feed.xml

# --- генераторы данных (DATA-P1-13, 2026-10-14) -----------------------------
# Причина та же, что у sitemap и feed, но тише: страница грузит артефакт
# `fetch` и рисует его содержимое. Отказ или порча файла не дают ошибки в
# консоли — просто неверные числа на странице. Замерено 2026-10-14:
# docs/interactions_graph.json от 2026-09-18 показывал 124 ребра при 146
# в живом docs/data.json, потому что генератор не вызывался НИ разу —
# ни в хуке, ни в CI (в workflows упоминается только build_api.py как
# триггер). Ни один из 13 build_* в хуке не запускался.
#
# Добавляются только ДЕТЕРМИНИРОВАННЫЕ генераторы: их вывод — функция
# только входных файлов, без времени, поэтому файл в индексе не меняется
# и коммит не засоряется. build_index.py сюда НЕ годится: он пишет
# `_meta.generated_at = now` в каждый прогон, то есть замусорил бы
# docs/data_index.json при каждом коммите. Тот же запрет на даты в
# артефакте — причина обязательного --commit-date у sitemap и feed.
#
# Генератор падает на настоящей поломке (битый data.json, отсутствующий
# вход), и блокировать коммит тут правильно: иначе pytest ниже поймает
# рассинхрон, но сообщение будет про тест, а не про причину.
echo "-> build_interactions_graph.py / build_timeseries.py"
"$PY" scripts/build_interactions_graph.py || {
    echo ""
    echo "GRAPH FAILED. docs/interactions_graph.json не обновлён, коммит прерван."
    echo "Причина обычно видна в строке выше (битый docs/data.json?)."
    exit 1
}
"$PY" scripts/build_timeseries.py || {
    echo ""
    echo "TIMESERIES FAILED. docs/timeseries.json не обновлён, коммит прерван."
    echo "Причина обычно видна в строке выше (битый data/timeseries/*.json?)."
    exit 1
}
git add docs/interactions_graph.json docs/timeseries.json

# --- граф: --check генераторов (PAGES_REVIEW п.20, 2026-10-17) -------------
# build_graph_data.py и build_graph_positions.py — детерминированные
# генераторы артефактов графа. --check не пишет, только сверяет с текущим
# файлом и выходит с кодом 1 при расхождении. Работают на закоммиченных
# data.json / effect_tags.json / graph_mech_edges.json. Не требуют git add:
# вывод --check не меняет файлы, а только валидирует.
echo "-> build_graph_data.py --check / build_graph_positions.py --check"
"$PY" scripts/build_graph_data.py --check || {
    echo ""
    echo "GRAPH_DATA CHECK FAILED. docs/graph_data.json не совпадает с генератором."
    echo "Запусти python scripts/build_graph_data.py и закоммить результат."
    exit 1
}
"$PY" scripts/build_graph_positions.py --check || {
    echo ""
    echo "GRAPH_POSITIONS CHECK FAILED. docs/graph_positions.json не совпадает с генератором."
    echo "Запусти python scripts/build_graph_positions.py и закоммить результат."
    exit 1
}

# --- sitemap check внутри hook (v5.6.2, 2026-10-08) ---------------------------
# test_real_docs_sitemap_is_current ИСКЛЮЧЁН из прогона hook намеренно. Тест
# вызывает build_sitemap.py --check, который индекс игноририрует by design и
# берёт lastmod из git log. А hook двумя строками выше перегенерировал sitemap
# с --commit-date, то есть для файлов из индекса записал дату СЕГОДНЯ. Для
# незакоммиченного docs/trends.html эти две даты расходятся (последний коммит
# 2026-10-07, дата коммита 2026-10-08) и тест падает. Замерено 2026-10-08:
# единственное расхождение — trends.html, check=2026-10-07 file=2026-10-08.
# index.html совпал случайно, его последний коммит тоже датирован сегодня.
# Логика дефекта: ЛЮБОЙ коммит, трогающий docs/*.html, у чьей даты
# последнего коммита не сегодня, валит hook. Внесено коммитом 7c56970.
# Тест НЕ выключен: он остаётся в `pytest -q` и в CI, где индекс на чистом
# checkout пуст и проверка корректна. Вне hook он — гейт, внутри hook — тупик.
#
# test_live_docs_feed_is_current (v5.6.4) исключён по РОВНО той же причине,
# и это не гипотеза, а механика флага: блок feed выше перегенерировал фид с
# --commit-date, то есть для docs/sup/index.html из индекса записал дату
# СЕГОДНЯ, а `--check` в тесте считает дату из истории. Для любого коммита,
# трогающего docs/sup/index.html, эти две даты разойдутся — то есть ровно
# те коммиты, ради которых в хук добавлен feed, запрещали бы сами себя.
# В CI и в обычном `pytest -q` тест остаётся и там проверка корректна.
#
# Строка -m сохранена без изменений: tests/test_precommit_hook.py:57 требует
# наличие "not network and not snapshot_data" в тексте этого хука.
echo "-> pytest -q -m 'not network and not snapshot_data' -k 'not real_docs_sitemap_is_current and not live_docs_feed_is_current'"
"$PY" -m pytest -q -m "not network and not snapshot_data" -k "not real_docs_sitemap_is_current and not live_docs_feed_is_current" --no-header 2>&1
RC=$?

if [ $RC -ne 0 ]; then
    echo ""
    echo "TESTS FAILED (exit $RC). Commit aborted."
    echo "Emergency: git commit --no-verify"
    exit 1
fi

echo "OK: tests passed"
exit 0
