<script>
document.addEventListener('DOMContentLoaded', function () {
  // v5.4.0 (dark-first): тёмная тема — это ОТСУТСТВИЕ класса light.
  // Раньше здесь стояло add('dark'), и тема задавалась явно; теперь
  // light добавляется только когда пользователь выбрал светлую.
  var light = localStorage.getItem('theme') === 'light';
  if (light) { document.body.classList.add('light'); document.documentElement.classList.add('light'); }
  var b = document.getElementById('themeBtn');
  if (b) b.textContent = light ? t("theme.dark") : t("theme.light");
  if (b) b.setAttribute('aria-label', light ? t("a11y.themeToDark") : t("a11y.themeToLight"));
  if (b) b.onclick = function () {
    var on = !document.documentElement.classList.contains('light');
    document.documentElement.classList.toggle('light', on);
    document.body.classList.toggle('light', on);
    b.textContent = on ? t("theme.dark") : t("theme.light");
    b.setAttribute('aria-label', on ? t("a11y.themeToDark") : t("a11y.themeToLight"));
    localStorage.setItem('theme', on ? 'light' : 'dark');
  };
});
</script>

{# v5.6.3 E4: cookie-баннер и Метрика скопированы из docs/sup/*.html — там этот хвост байт-в-байт одинаков на всех 131 страницах (sha256 b1a5cfce2a25), а в шаблоне его не было и прогон build_sup.py срезал его сразу у всех. Комментарий в строку с HTML-комментарием: с новой строки он дал бы лишнюю строку из пробелов. #}<!-- v5.6.2: cookie-согласие + Яндекс.Метрика (счётчик 112465667).
     Метрика грузится ТОЛЬКО после нажатия «Принять»: до согласия
     ни одного запроса к mc.yandex.ru не происходит. -->
<div id="cookieBanner" role="dialog" data-i18n-aria-label="a11y.cookieConsent" hidden>
  <div class="cb-text">
    <span data-i18n-text="index.cookieText">Мы используем cookie и Яндекс.Метрику, чтобы понять, какие материалы полезны. Аналитика включается только после вашего согласия.</span>
    <a href="../privacy.html" data-i18n-text="index.cookiePolicy">Политика конфиденциальности</a>
  </div>
  <div class="cb-actions">
    <button type="button" id="cookieAccept" class="cb-btn cb-accept" data-i18n-text="index.cookieAccept">Принять</button>
    <button type="button" id="cookieReject" class="cb-btn cb-reject" data-i18n-text="index.cookieReject">Отклонить</button>
  </div>
</div>
<script src="../cookie-banner.js?v=1"></script>
<script src="../metrika.js?v=1"></script>
<script>initCookieBanner();</script>
<script>
// Кнопка «+ Сравнить»: сохраняет id в localStorage, тост + авто-переход на сравнение.
(function () {
  var btn = document.querySelector('.cmp-add');
  if (!btn) return;
  var id = btn.getAttribute('data-cmp');
  function showToast(msg) {
    var t = document.createElement('div');
    // A11Y-12: тост объявляется скринридером (role="status" + aria-live)
    t.setAttribute('role', 'status');
    t.setAttribute('aria-live', 'polite');
    t.textContent = msg;
    t.style.cssText = 'position:fixed;bottom:20px;left:50%;transform:translateX(-50%);padding:.6rem 1.2rem;background:rgba(0,0,0,.85);color:#fff;border-radius:8px;font-size:.9rem;z-index:9999;opacity:0;transition:opacity .2s';
    document.body.appendChild(t);
    requestAnimationFrame(function () { t.style.opacity = '1'; });
    setTimeout(function () {
      t.style.opacity = '0';
      setTimeout(function () { t.remove(); }, 200);
    }, 2000);
  }
  btn.addEventListener('click', function (e) {
    // SE2-04: элемент — ссылка, поэтому навигация работает и без JS.
    // Перехватываем только обычный левый клик без модификаторов, чтобы
    // успеть записать id в localStorage перед переходом.
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
    e.preventDefault();
    var arr = [];
    try { arr = JSON.parse(localStorage.getItem('compareIds') || '[]'); } catch (e) {}
    if (!arr.includes(id)) {
      arr.push(id);
      localStorage.setItem('compareIds', JSON.stringify(arr));
    }
    btn.textContent = t('cmp.btn.added');
    btn.setAttribute('aria-disabled', 'true');
    showToast(t('cmp.toast.added'));
    location.href = btn.getAttribute('href');
  });
})();

// FIX-74: подпись счётчика собирается через t(), поэтому число источников
// склоняется по-русски и не склоняется по-английски.
function pmidWord(n) {
  if (LOCALE === 'ru') {
    var d = n % 10, dd = n % 100;
    if (d === 1 && dd !== 11) return t('sup.pmidOne');
    if (d >= 2 && d <= 4 && (dd < 12 || dd > 14)) return t('sup.pmidFew');
    return t('sup.pmidMany');
  }
  return n === 1 ? t('sup.pmidOne') : t('sup.pmidMany');
}

// Count-up анимация для PMID-счётчика (IntersectionObserver + requestAnimationFrame)
(function(){
  var badge = document.querySelector('.pmid-badge[data-target]');
  if(!badge) return;
  var m = badge.textContent.match(/(\d+)/);
  if(!m) return;
  var target = +m[1];
  var obs = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){
        var dur = 700, t0 = performance.now();
        function raf(now){
          var p = Math.min((now-t0)/dur, 1);
          badge.textContent = '🔬 ' + Math.floor(p*target) + ' ' + pmidWord(Math.floor(p*target)) + ' ' + t('sup.pmidIn');
          if(p<1) requestAnimationFrame(raf); else obs.disconnect();
        }
        requestAnimationFrame(raf);
        obs.disconnect();
      }
    });
  });
  obs.observe(badge);
})();

// Кнопка «Цитировать»: копирует цитирование в формате APA в буфер обмена
(function(){
  var btn = document.getElementById('citeBtn');
  var tip = document.getElementById('citeTooltip');
  if(!btn) return;
  var name = {{ name_js|safe }};
  var url = {{ url_js|safe }};
  btn.onclick = function(){
    var text = 'brain-25-evidence. (2026). ' + name + '. Retrieved from ' + url;
    function citetip(ok){
      // I18N-02: строки тултипа вынесены в словарь i18n.js
      tip.textContent = ok ? t('cite.copied') : t('cite.copyFailed');
      tip.setAttribute('aria-hidden','false');
      setTimeout(function(){ tip.setAttribute('aria-hidden','true'); }, 2000);
    }
    function citeFallback(){
      try {
        var ta = document.createElement('textarea');
        ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
        ta.setAttribute('readonly','');
        document.body.appendChild(ta); ta.select();
        var ok = document.execCommand('copy');
        document.body.removeChild(ta);
        citetip(ok);
      } catch(e) { citetip(false); }
    }
    if(navigator.clipboard && navigator.clipboard.writeText){
      // FIX-SPRINT B2: промис без catch давал необработанную ошибку
      // в консоли, когда браузер отводил writeText (headless, права).
      navigator.clipboard.writeText(text).then(function(){ citetip(true); }).catch(citeFallback);
    } else { citeFallback(); }
  };
})();

// Кнопка «Прослушать»: TTS через Web Speech API
(function(){
  var btn = document.getElementById('ttsBtn');
  if(!btn) return;
  if(!window.speechSynthesis){ btn.style.display = 'none'; return; }  
  var currentUtterance = null; // CWV-05: текущее utterance (сбрасывается в onend/onerror)
  var name = {{ name_js|safe }};
  var effects = {{ effects_json|safe }};
  btn.onclick = function(){
    var ttsLang = 'ru';
    if (typeof LOCALE !== 'undefined' && LOCALE) ttsLang = LOCALE;
    if (ttsLang === 'ru') ttsLang = 'ru' + '-RU';
    // CWV-05: не копим устаревшие utterance. Повторный клик гасит начатую
    // речь, а ссылка сбрасывается, когда utterance доиграл или упал —
    // иначе SpeechSynthesis удерживает его (и слушателей) в памяти.
    if (currentUtterance) window.speechSynthesis.cancel();
    var utterance = new SpeechSynthesisUtterance(name + (effects ? ', ' + effects : ''));
    utterance.lang = ttsLang;
    utterance.onend = function () { if (currentUtterance === utterance) currentUtterance = null; };
    utterance.onerror = function () { if (currentUtterance === utterance) currentUtterance = null; };
    currentUtterance = utterance;
    window.speechSynthesis.speak(utterance);
  };
})();

// Кнопка «🎲 Удиви меня»: случайная добавка из каталога.
// Список страниц берём из sitemap.xml — там уже готовые URL по slug
// (sup/magniy.html). Раньше здесь собирались d.id из data.json и
// открывался 'sup/' + id + '.html'; id — отображаемое имя (кириллица),
// а файлы называются по slug, плюс на этой странице добавлялся лишний
// префикс sup/, потому что страница уже лежит в sup/. Кнопка вела на
// 404 всегда. slugify живёт в Python (scripts/build_sup.py) и в JS
// не дублируется.
(function(){
  var btn = document.getElementById('randomBtn');
  if(!btn) return;
  var sitemapUrl = new URL('../sitemap.xml', location.href).href;
  btn.onclick = function(){
    fetch(sitemapUrl).then(function(r){ return r.text(); }).then(function(xml){
      var doc = new DOMParser().parseFromString(xml, 'application/xml');
      var urls = [];
      doc.querySelectorAll('url > loc').forEach(function(node){
        var u = (node.textContent || '').trim();
        if(/\/sup\/[^/]+\.html$/.test(u) && !/\/sup\/index\.html$/.test(u)) urls.push(u);
      });
      if(!urls.length){ console.warn('[random] в sitemap.xml нет страниц добавок'); return; }
      location.href = urls[Math.floor(Math.random() * urls.length)];
    }).catch(function(err){ console.warn('[random] не удалось загрузить sitemap.xml', err); });
  };
})();
</script>
</body>
</html>

