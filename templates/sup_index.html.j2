<!DOCTYPE html>
<html lang="ru" dir="ltr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    {# SEO-P1-01 шаг 3: формат заголовка и длина описания приведены к
       нормам аудита, og:title = <title>. Раньше заголовок каталога был
       75 символов и начинался с «|», а og:title от него отличался.
       Комментарий закрыт без перевода строки, как на карточках.
       v5.6.5 (SEO-P2-01): описание вынесено в seo_desc и больше не повторяется
       вручную трижды. Раньше JSON-LD держал укороченную копию, а meta и og —
       полную, поэтому правка одной строки расходилась с двумя другими. #}<title>Каталог БАДов: {{ total }} добавок — Brain 25 Evidence</title>
    {% set seo_desc = "Каталог из " ~ total ~ " БАД: название, категория, ведикт и грейд доказательности A-D. Карточка ведёт на страницу добавки с механизмами и дозировкой." %}
    <meta name="description" content="{{ seo_desc }}">
    <link rel="canonical" href="{{ url }}">
    {# v5.6.0 этап 5: RSS-фид docs/feed.xml. Каталог — вход в раздел,
       поэтому ссылка на фид здесь нужна не меньше, чем на карточках.
       Комментарий закрыт без перевода строки, иначе в вывод попала бы
       строка из одних пробелов. #}<link rel="alternate" type="application/rss+xml" title="brain-25-evidence" href="{{ base_url }}/feed.xml">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ url }}">
    <meta property="og:title" content="Каталог БАДов: {{ total }} добавок — Brain 25 Evidence">
    <meta property="og:description" content="{{ seo_desc }}">
    <meta property="og:image" content="{{ base_url }}/og.png">
    <meta property="og:site_name" content="Brain 25 Evidence">
<meta property="og:locale" content="ru_RU">
    <meta name="twitter:card" content="summary_large_image">
    {# v5.6.5 FIX-61 (MK2-03): каталог отдавал только карточку — title,
       description и image добавлены дословными копиями og:* выше.
       Комментарий закрыт без перевода строки, как на карточках. #}<meta name="twitter:title" content="Каталог БАДов: {{ total }} добавок — Brain 25 Evidence">
    <meta name="twitter:description" content="{{ seo_desc }}">
    <meta name="twitter:image" content="{{ base_url }}/og.png">
    <link rel="manifest" href="../manifest.webmanifest">
    <meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#1c1c1e" media="(prefers-color-scheme: dark)">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="БАДы">
    <link rel="apple-touch-icon" href="../icons/192.png">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🧠</text></svg>">
    <script>
    try {
      if (localStorage.getItem('theme') === 'light') {
        document.documentElement.classList.add('light');
      }
    } catch(e) {}
    </script>
    <link rel="stylesheet" href="../style.min.css?v=467">
    <script src="../version.js?v=312" defer></script>
    <script src="../i18n.js?v=18" defer></script>
    <script src="../pwa.js?v=284" defer></script>
    <script src="../share.js?v=2" defer></script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Каталог БАДов — Brain 25 Evidence",
      "description": "{{ seo_desc }}",
      "url": "{{ url }}",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Главная",
            "item": "{{ base_url }}/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Каталог БАДов",
            "item": "{{ url }}"
          }
        ]
      }
    }
    </script>
    <style>
    /* Локальных правил два, и второе обязательное.
       Первое: карточка каталога — это ссылка, а в style.css есть голое
       правило `a`, которое красит любую ссылку в акцентный цвет и
       подчёркивает её. Без этих трёх свойств сетка из {{ total }} карточек
       читалась бы как список синих ссылок, а не как сетка главной
       страницы.
       Второе: `display:block` выше перебивает пользовательский агент —
       [hidden]{display:none} специфичностью 0,1,0 против 1,1,0 здесь, и
       фильтр прятал бы карточки по счётчику, но не по факту: они остались
       бы на экране. Замерено в Playwright, а не предположено.
       Всё остальное (сетка, стекло, hover, тени, цвета, шрифты) берётся
       из style.css — своих цветов страница не вводит и обе темы
       наследует оттуда же. */
    #cardsGrid .card{display:block;color:inherit;text-decoration:none}
    #cardsGrid .card[hidden]{display:none}
    </style>
</head>
<body>
<a href="#main" class="skip-link" data-i18n-text="a11y.skipToContent">Перейти к содержимому</a>

<div class="site-header">
  <div class="trustbar" data-i18n-text="index.trustbar">🧬 Открытые данные · Бесплатно · Без рекламы</div>
  <header class="top">
    <div class="site-title"><a href="../index.html"><span class="h1-emoji">🧠</span> brain-25-evidence</a></div>
    <nav class="actions" data-i18n-aria-label="a11y.navMain">
      <a class="btn c-feedback" href="../feedback.html" data-i18n-text="index.feedback">💬 Обратная связь</a>
      <a class="btn c-support" href="../support.html" data-i18n-text="index.support">💚 Поддержать</a>
      <!-- FIX-75: aria-label у #themeBtn ставит скрипт темы (t("a11y.themeToDark") /
           t("a11y.themeToLight")) — статический атрибут перетирался и ломал EN-гейт. -->
      <button class="btn c-theme" id="themeBtn">🌞 Светлая тема</button>
      <select id="langSelect" class="lang-select" data-i18n-aria-label="a11y.langSelect"><option value="ru">RU</option><option value="en">EN</option></select>
      <button class="btn c-random" id="randomBtn" data-i18n-text="index.random">🎲 Удиви меня</button>
    </nav>
  </header>
</div>

<main id="main">
  <h1 data-i18n-text="supcat.h1">Каталог БАДов</h1>

    <nav class="breadcrumbs">
        {# v5.6.3 E4: прежний комментарий E2 стоял на отдельной строке, и Jinja выводил после него строку из 8 пробелов — на docs/sup/index.html такой строки нет, и прогон build_sup.py добавлял её заново. Комментарий сжат в строку с крошкой: смысл прежний, крошка «Назад» удалена, потому что она вела на тот же ../index.html, что и «Главная». #}<a href="../index.html" data-i18n-text="nav.home">Главная</a> → <strong data-i18n-text="supcat.h1">Каталог БАДов</strong>
    </nav>

    <p class="hint" data-i18n-text="supcat.intro" data-i18n-vars='{"n": "{{ total }}"}'>{{ total }} добавок: название, категория, вердикт и грейд доказательности A-D. Карточка ведёт на страницу добавки.</p>

    <section id="controls">
      <label for="supSearch" class="sr-only" data-i18n-text="supcat.searchLabel">Поиск по названию, категории или вердикту</label>
      <input id="supSearch" data-i18n-placeholder="sup.searchPh"/>
      <label for="supCategory" class="sr-only" data-i18n-text="supcat.filterCategory">Фильтр: категория</label>
      <select id="supCategory">
        <option value="all" data-i18n-text="supcat.anyCategory">Любая категория</option>
        {% for cat in categories %}<option value="{{ cat.name }}">{{ cat.name }} ({{ cat.count }})</option>{% endfor %}
      </select>
      <label for="supGrade" class="sr-only" data-i18n-text="supcat.filterGrade">Фильтр: грейд доказательности</label>
      <select id="supGrade">
        <option value="all" data-i18n-text="supcat.anyGrade">Любой грейд</option>
        {% for g in grades %}<option value="{{ g.value }}" data-i18n-text="supcat.gradeOption" data-i18n-vars='{"g": "{{ g.value }}", "n": "{{ g.count }}"}'>Грейд {{ g.value }} ({{ g.count }})</option>{% endfor %}
      </select>
    </section>

    <section id="cardsContainer">
      <!-- v5.6.5: live-регион (A11Y-P2-05). Бейдж переписывается при
           каждом изменении фильтра (sup_index.html.j2:190) — без
           озвучивания результат фильтрации был виден только глазами. -->
      <h2><span data-i18n-text="supcat.allSupplements">Все добавки</span> <span id="countBadge" class="hint" role="status" aria-live="polite" data-i18n-text="supcat.shown" data-i18n-vars='{"shown": "{{ total }}", "total": "{{ total }}"}'>показано {{ total }} из {{ total }}</span></h2>

      <div id="cardsGrid">
        {% for c in cards %}
        <a class="card" href="{{ c.slug }}.html" data-sup-id="{{ c.id }}" data-slug="{{ c.slug }}" data-cat="{{ c.category }}" data-grade="{{ c.grade }}" data-code="{{ c.code }}" data-hay="{{ c.hay }}">
          <span class="cat" data-sup="category">{{ c.category }}</span>
          <strong class="card-title" data-sup="name">{{ c.name }}</strong>
          <div class="verdict v{{ c.code }}" data-sup="verdict">{{ c.verdict }}</div>
          <span class="grade g{{ c.grade }}" data-i18n-title="supcat.gradeTooltip" data-i18n-text="supcat.gradeShort" data-i18n-vars='{"g": "{{ c.grade }}"}' title="Грейд {{ c.grade }} — шкала доказательности (см. glossary.html)">Грейд {{ c.grade }}</span>
        </a>
        {% endfor %}
      </div>

      <p class="hint"><span data-i18n-text="supcat.scaleA">Шкала доказательности A-D расшифрована в</span> <a href="../glossary.html" data-i18n-text="supcat.scaleGlossary">глоссарии</a><span data-i18n-text="supcat.scaleB">, методика подсчёта — в</span> <a href="../methodology.html" data-i18n-text="supcat.scaleMethodology">методологии</a>.</p>
    </section>
</main>

<footer class="site-footer">
