    <b data-i18n-text="index.discNo">НЕ заменяет</b> <span data-i18n-text="index.discB">консультацию, диагноз и лечение.
    При любых сомнениях — обращайтесь к специалисту.</span>
  </p>
  <p class="meta">
    v<span data-version="app"></span> ·
    <span data-i18n-text="index.dataUpdated">данные на</span> <span data-version="data"></span>
  </p>
  {# v5.6.3 E4: ссылка на privacy добавлена — на 131/131 страницах docs/sup/ она есть, а шаблон остался позади и прогон build_sup.py её срезал. Комментарий в строку с тегом: с новой строки он дал бы в выводе лишнюю строку из пробелов. #}<p class="links">
    <a href="../methodology.html" data-i18n-text="footer.methodology">📐 Методология</a> ·
    <a href="../faq.html" data-i18n-text="footer.faq">❓ FAQ</a> ·
    <a href="../glossary.html" data-i18n-text="footer.glossary">📖 Глоссарий</a> ·
    <a href="../privacy.html" data-i18n-text="footer.privacy">🔐 Приватность</a> ·
    <a href="../terms-of-use.html" data-i18n-text="footer.terms">📄 Условия использования</a> ·
    <a href="index.html" data-i18n-text="footer.catalog">💊 Каталог БАДов</a> ·
    <a href="../feed.xml" data-i18n-text="footer.rss">📡 RSS</a>
  </p>
  <p class="copy">© 2026 Vladislav "DeadSno" Pereshivalov · MIT · <a href="../terms-of-use.html#data-license" data-i18n-text="index.dataLicense">Данные: CC BY 4.0</a></p>
  <p class="share-row"><button class="btn share-page" type="button" data-i18n-text="index.share">🔗 Поделиться</button></p>
</footer>

<script>
document.addEventListener('DOMContentLoaded', function () {
  // v5.4.0 (dark-first): тёмная тема — это ОТСУТСТВИЕ класса light.
  // Раньше здесь стояло add('dark'), и тема задавалась явно; теперь
  // light добавляется только когда пользователь выбрал светлую.
  var light = localStorage.getItem('theme') === 'light';
  if (light) { document.body.classList.add('light'); document.documentElement.classList.add('light'); }
  var b = document.getElementById('themeBtn');
  if (b) b.textContent = light ? t("theme.dark") : t("theme.light");
  if (b) b.setAttribute('aria-label', light ? t("a11y.themeToDark") : t("a11y.themeToLight"));
  if (b) b.onclick = function () {
    var on = !document.documentElement.classList.contains('light');
    document.documentElement.classList.toggle('light', on);
    document.body.classList.toggle('light', on);
    b.textContent = on ? t("theme.dark") : t("theme.light");
    b.setAttribute('aria-label', on ? t("a11y.themeToDark") : t("a11y.themeToLight"));
    localStorage.setItem('theme', on ? 'light' : 'dark');
  };

  // Фильтры каталога. Карточки уже в разметке — скрипт только прячет
  // несовпавшие, поэтому страница читается и работает без JS: без него
  // видны все {{ total }} карточек и текст счётчика уже верный.
  var cards = [].slice.call(document.querySelectorAll('#cardsGrid .card'));
  var search = document.getElementById('supSearch');
  var category = document.getElementById('supCategory');
  var grade = document.getElementById('supGrade');
  var badge = document.getElementById('countBadge');

  function apply() {
    var needle = (search.value || '').trim().toLowerCase();
    var cat = category.value;
    var gr = grade.value;
    var shown = 0;
    for (var i = 0; i < cards.length; i++) {
      var c = cards[i];
      var ok = true;
      if (needle && c.getAttribute('data-hay').indexOf(needle) === -1) ok = false;
      if (ok && cat !== 'all' && c.getAttribute('data-cat') !== cat) ok = false;
      if (ok && gr !== 'all' && c.getAttribute('data-grade') !== gr) ok = false;
      if (ok) { c.removeAttribute('hidden'); shown++; }
      else { c.setAttribute('hidden', ''); }
    }
    badge.textContent = t('supcat.shown', { shown: shown, total: cards.length });
  }

  search.addEventListener('input', apply);
  category.addEventListener('change', apply);
  grade.addEventListener('change', apply);
});
</script>

{# v5.6.3 E4: cookie-баннер и Метрика скопированы из docs/sup/*.html — там этот хвост байт-в-байт одинаков на всех 131 страницах (sha256 b1a5cfce2a25), а в шаблоне его не было и прогон build_sup.py срезал его сразу у всех. Комментарий в строку с HTML-комментарием: с новой строки он дал бы лишнюю строку из пробелов. #}<!-- v5.6.2: cookie-согласие + Яндекс.Метрика (счётчик 112465667).
     Метрика грузится ТОЛЬКО после нажатия «Принять»: до согласия
     ни одного запроса к mc.yandex.ru не происходит. -->
<div id="cookieBanner" role="dialog" data-i18n-aria-label="a11y.cookieConsent" hidden>
  <div class="cb-text">
    <span data-i18n-text="index.cookieText">Мы используем cookie и Яндекс.Метрику, чтобы понять, какие материалы полезны. Аналитика включается только после вашего согласия.</span>
    <a href="../privacy.html" data-i18n-text="index.cookiePolicy">Политика конфиденциальности</a>
  </div>
  <div class="cb-actions">
    <button type="button" id="cookieAccept" class="cb-btn cb-accept" data-i18n-text="index.cookieAccept">Принять</button>
    <button type="button" id="cookieReject" class="cb-btn cb-reject" data-i18n-text="index.cookieReject">Отклонить</button>
  </div>
</div>
<script src="../cookie-banner.js?v=1"></script>
<script src="../metrika.js?v=1"></script>
<script>initCookieBanner();</script>
</body>
</html>

