+def test_default_base_url_matches_what_tests_use():
+    """Адрес гейта обязан совпадать с адресом тестов.
+
+    Проверено по исходникам: BASE_URL в test_visual_snapshots.py,
+    test_tabs_interaction.py и test_graph_interaction.py — это
+    `SNAPSHOT_BASE_URL` с откатом на `http://localhost:8000`.
+
+    Паттерн строится ИЗ DEFAULT_BASE_URL, а не из литерала. Прежняя версия
+    теста держала в регулярке «http://localhost:8000» строкой и использовала
+    DEFAULT_BASE_URL только в тексте ошибки — то есть смена адреса в
+    conftest.py оставила бы тест зелёным, и он проверял бы не то.
+    """
+    import re
+    from pathlib import Path
+
+    root = Path(__file__).resolve().parents[1]
+    pattern = re.escape(DEFAULT_BASE_URL)
+    for name in ("test_visual_snapshots.py", "test_tabs_interaction.py",
+                 "test_graph_interaction.py"):
+        text = (root / "tests" / name).read_text(encoding="utf-8")
+        assert re.search(rf'SNAPSHOT_BASE_URL",\s*"{pattern}"', text), (
+            f"{name}: адрес по умолчанию разошёлся с {DEFAULT_BASE_URL}. "
+            f"Гейт проверяет один сервер, а тесты бьют в другой."
+        )
+
