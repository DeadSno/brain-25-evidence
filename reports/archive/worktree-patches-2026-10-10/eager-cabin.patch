+def test_missing_server_deps_detects_broken_import(monkeypatch):
+    """Модуль, который НАХОДИТСЯ, но не импортируется, — тоже «нет».
+
+    Регрессия на find_spec: замер показал, что find_spec для подменённого numpy
+    возвращал ModuleSpec (файл-то лежит), гейт считал зависимость на месте — и
+    прогон давал «2 skipped» при живом сервере.
+    """
+    import importlib
+    import sys
+
+    monkeypatch.setitem(sys.modules, "numpy", None)  # None = "модуль сломан"
+    real_import = importlib.import_module
+
+    def fake_import(name, *a, **kw):
+        if name == "numpy":
+            raise ModuleNotFoundError("No module named 'numpy'", name="numpy")
+        return real_import(name, *a, **kw)
+
+    monkeypatch.setattr(importlib, "import_module", fake_import)
+
+    from tests.conftest import missing_server_deps
+
+    assert "numpy" in missing_server_deps()
+    assert "playwright" not in missing_server_deps()
