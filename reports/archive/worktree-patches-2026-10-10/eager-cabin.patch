+def test_never_fails_in_ci_even_when_reachable_state_flips():
+    """В CI гейт не имеет права упасть НИ при каком сочетании — перебор.
+
+    Инвариант именно «не fail», а не «всегда skip»: если сервер в CI всё-таки
+    поднят, проверять надо (`run`). Запрещено только падать, потому что CI
+    сервер не поднимает и падение там означало бы «упало окружение», а не
+    «упал код». Первая версия теста требовала `skip` всегда и тем самым ломала
+    случай «сервер есть» — тест был неправ, а не код.
+    """
+    gates = {"RUN_A11Y": "a11y"}
+    for reachable in (True, False):
+        for allow_skip in (True, False):
+            verdict = server_gate_verdict(gates, reachable, True, allow_skip)
+            assert verdict != "fail", (
+                f"reachable={reachable} allow_skip={allow_skip} дал {verdict!r}; "
+                f"CI обязан быть терпимым к среде"
+            )
+
