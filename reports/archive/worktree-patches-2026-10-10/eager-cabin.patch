+# ──────────────────────── server_reachable: сеть подменена ────────────────────────
+
+class _Resp:
+    """Заглушка ответа urlopen. read() отдаёт заранее заданные байты."""
+
+    def __init__(self, status=200, body=b""):
+        self.status = status
+        self._body = body
+
+    def read(self):
+        return self._body
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *a):
+        return False
+
+
+def _fake_urlopen(monkeypatch, version_resp=None, css_resp=None):
+    """Подмена urlopen: маршрут выбирается по запрошенному URL.
+
+    Никакой сети: оба ответа (version.json и style.css) подставляет тест.
+    """
+    import urllib.request
+
+    def fake(url, timeout=None):
+        if "style.css" in url:
+            if css_resp is None:
+                raise OSError("no style.css")
+            return css_resp
+        if version_resp is None:
+            raise OSError("connection refused")
+        return version_resp
+
+    monkeypatch.setattr(urllib.request, "urlopen", fake)
+
+
+def test_reachable_when_server_serves_our_css(monkeypatch):
+    """Живой сервер с НАШИМ style.css — единственный случай True."""
+    local = (ROOT / "docs" / "style.css").read_bytes()
+    _fake_urlopen(monkeypatch, version_resp=_Resp(), css_resp=_Resp(body=local))
+    assert server_reachable("http://localhost:8000") is True
+
+
+def test_not_reachable_on_foreign_css(monkeypatch):
+    """ЧУЖАЯ копия проекта — это не «сервер есть».
+
+    Именно этот случай ратифицировал гейт: отвечает, но отдаёт не наш код,
+    и тесты потом скипались на сверке хэша с кодом 0.
+    """
+    _fake_urlopen(monkeypatch, version_resp=_Resp(), css_resp=_Resp(body=b"other"))
+    assert server_reachable("http://localhost:8000") is False
+
+
+def test_not_reachable_when_connection_refused(monkeypatch):
+    _fake_urlopen(monkeypatch, version_resp=None)
+    assert server_reachable("http://localhost:8000") is False
+
+
+def test_not_reachable_when_no_style_css(monkeypatch):
+    """Сервер жив, но style.css не отдал — проверять нечего."""
+    _fake_urlopen(monkeypatch, version_resp=_Resp(), css_resp=None)
+    assert server_reachable("http://localhost:8000") is False
+
+
+def test_not_reachable_on_5xx(monkeypatch):
+    """5xx — сервер есть, но сломан: проходить нельзя."""
+    import urllib.error
+
+    def fake(url, timeout=None):
+        raise urllib.error.HTTPError(url, 503, "boom", {}, None)
+
+    import urllib.request
+    monkeypatch.setattr(urllib.request, "urlopen", fake)
+    assert server_reachable("http://localhost:8000") is False
