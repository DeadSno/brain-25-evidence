 """Общие фикстуры для тестов brain-25-evidence."""
+import hashlib
 import os
 import sys
+import urllib.error
+import urllib.request
 from pathlib import Path
 
 import pytest
@@ -11,6 +14,267 @@ sys.path.insert(0, str(ROOT))
 DB_PATH = ROOT / "data" / "db" / "brain.duckdb"
 
 
+# ──────────────────────── §17: пропуск не должен выглядеть зелёным ────────────────────────
+#
+# Замерено на этой копии ДО правки:
+#     $env:RUN_SNAPSHOTS="1"; $env:SNAPSHOT_BASE_URL="http://localhost:8099"
+#     pytest -q -m snapshots
+#     -> 76 skipped, 824 deselected; EXITCODE=0
+#
+# То есть человек СКАЗАЛ «проверь меня снапшотами», получил ноль проверенных
+# пикселей и зелёный код возврата. Это ровно та ловушка, что описана в AGENTS.md
+# («skipped looks like green»), и она молчала во всех четырёх файлах.
+#
+# ПОЧЕМУ НЕ «падать всегда, когда :8000 лежит». Гейт привязан к ЯВНОМУ
+# включению набора, а не к факту отсутствия сервера. Замерено: обычный
+# `pytest -q` собирает 1065 тест и не обращается к :8000 ни разу. Падение
+# всего прогона из-за сервера, который этому прогону не нужен, — это не
+# честность, а просто новый способ ничего не запускать.
+#
+# ПОЧЕМУ НЕ `RUN_E2E`. Тесты e2e (tests/test_e2e_smoke.py, test_ui_verify.py)
+# поднимают СВОЙ http.server на :8123 и к :8000 не ходят (проверено: PORT = 8123
+# в обоих файлах). Включать их в этот гейт — ложное срабатывание.
+
+#: Переменные окружения, каждая из которых включает набор, требующий :8000.
+#: Ключ — имя переменной, значение — что именно она запускает (для сообщения).
+SERVER_GATES = {
+    "RUN_SNAPSHOTS": "визуальные эталоны",
+    "RUN_A11Y": "тесты доступности",
+    "RUN_TABS": "клик по вкладкам",
+    "RUN_GRAPH": "экспорт PNG и раскладка графа",
+}
+
+#: Куда стучимся. Тот же адрес и та же переменная, что в тестах: иначе гейт
+#: проверял бы один сервер, а тесты били бы в другой.
+DEFAULT_BASE_URL = "http://localhost:8000"
+
+#: Что стучимся. AGENTS.md называет version.json канонической проверкой
+#: живости сервера; для снятия шторки достаточно любого 200.
+PROBE_PATH = "/version.json"
+
+#: Модули, без которых серверные наборы уходят в SKIP на этапе ИМПОРТА
+#: (module-level pytest.importorskip в test_visual_snapshots.py:286-289 и
+#: test_a11y_axe.py:126). Имена — как в importorskip, до точки.
+#: Проверяются попыткой ИМПОРТА, а не find_spec: замер показал, что для
+#: подменённого numpy find_spec возвращает ModuleSpec (файл ведь есть), и дыра
+#: оставалась. Настоящая недоступность — это когда импорт падает.
+SERVER_DEPS = ("playwright", "numpy", "PIL")
+
+#: Таймаут короткий намеренно: гейт стоит ДО коллекции, и намертво
+#: захваченный порт не должен висеть на старте прогона.
+PROBE_TIMEOUT = 3.0
+
+
+def env_flag(name: str, env=None) -> bool:
+    """Истина, если переменная окружения включена.
+
+    Принимает 1/true/yes/on в любом регистре. Раньше здесь стояло сравнение
+    `== "1"`, и оно же использовалось для RUN_* как «непустая строка» — две
+    разные конвенции в одном файле. Замерено: с ALLOW_SERVER_SKIP=true
+    (не "1") обходной путь молча не срабатывал, и человек, который его
+    выставил, получал падение вместо пропуска.
+    """
+    env = os.environ if env is None else env
+    return env.get(name, "").strip().lower() in {"1", "true", "yes", "on"}
+
+
+def active_server_gates(env=None) -> dict:
+    """Какие наборы, требующие :8000, человек включил явно.
+
+    Возвращает {имя переменной: описание}, пустой dict — если ничего не
+    включено, и это НОРМАЛЬНЫЙ быстрый прогон.
+
+    Разбор значения — через env_flag, а не «непустая строка»: иначе
+    RUN_SNAPSHOTS=0 включал бы гейт, хотя человек явно писал «ноль», то есть
+    «выключено».
+    """
+    env = os.environ if env is None else env
+    return {
+        var: desc
+        for var, desc in SERVER_GATES.items()
+        if env_flag(var, env)
+    }
+
+
+def is_ci(env=None) -> bool:
+    """CI или нет. GitHub Actions ставит и CI, и GITHUB_ACTIONS."""
+    env = os.environ if env is None else env
+    return bool(env.get("CI") or env.get("GITHUB_ACTIONS"))
+
+
+def server_reachable(base_url: str, timeout: float = PROBE_TIMEOUT) -> bool:
+    """Отвечает ли сервер И отдаёт ли он ИМЕННО ЭТОТ репозиторий.
+
+    Проверки две, и вторая важнее первой. Замерено: подмена сервера на чужой
+    сайт, у которого есть version.json, давала «76 skipped, EXITCODE=0» —
+    гейт, который смотрит только на код ответа, ратифицировал бы ЧУЖУЮ копию
+    проекта, а тесты потом тихо скипались бы на сверке хэша style.css.
+
+    Это не экзотика: инструкция проекта предлагает
+    `python -m http.server 8000 --directory docs`, поэтому вторая копия
+    репозитория, уже занятая на :8000, даёт ровно этот сценарий.
+
+    True только если сервер жив И отдаёт наш style.css.
+    """
+    local_css = ROOT / "docs" / "style.css"
+    try:
+        with urllib.request.urlopen(f"{base_url}{PROBE_PATH}", timeout=timeout) as r:
+            if not (200 <= r.status < 400):
+                return False
+    except urllib.error.HTTPError as exc:
+        # Сервер жив, просто не отдал эту страницу — это не «сервера нет».
+        if exc.code >= 500:
+            return False
+    except Exception:  # noqa: BLE001 — любой сетевой сбой = «сервера нет»
+        return False
+
+    # Живость есть. Теперь личность: та же сверка, что в _check_server()
+    # каждого из четырёх наборов, — иначе гейт пропустил бы чужую копию.
+    try:
+        with urllib.request.urlopen(f"{base_url}/style.css", timeout=timeout) as r:
+            served = r.read()
+        return hashlib.sha256(served).hexdigest() == hashlib.sha256(
+            local_css.read_bytes()
+        ).hexdigest()
+    except Exception:  # noqa: BLE001 — не отдал style.css = сервера нет
+        return False
+
+
+def server_gate_verdict(gates: dict, reachable: bool, ci: bool, allow_skip: bool) -> str:
+    """Что делать прогону: 'run' | 'fail' | 'skip'.
+
+    Вынесено чистой функцией, потому что это единственное место, где
+    принимается решение «красить прогон в зелёный или нет», и оно обязано
+    проверяться тестами БЕЗ сети — иначе мы добавили бы в репозиторий ровно
+    ту непроверяемую логику, из-за которой всё и затевалось.
+    """
+    if not gates:
+        return "run"          # никто серверные тесты не просил — не мешаем
+    if reachable:
+        return "run"          # просил и сервер есть — всё честно
+    if ci or allow_skip:
+        return "skip"         # CI сервер не поднимает, человек снял гейт руками
+    return "fail"             # просил, сервера нет, а отчёт был бы зелёным
+
+
+def missing_server_deps() -> list:
+    """Модули, без которых наборы снимутся в SKIP на ИМПОРТЕ, а не на фикстуре.
+
+    Замерено на этой копии: с numpy, подменённым на модуль, бросающий
+    ModuleNotFoundError, `RUN_SNAPSHOTS=1 pytest -q -m snapshots` даёт
+    «2 skipped» и НОЛЬ выполненных тестов. importorskip ловит ModuleNotFoundError
+    и помечает модуль пропущенным — до того, как отработает любая фикстура.
+
+    Проверка живого сервера эту дыру не закрывает: сервер был поднят, гейт
+    честно сказал «run», а проверять было нечем.
+
+    Проба именно ИМПОРТА, а не find_spec: замер показал, что find_spec для
+    подменённого numpy возвращает ModuleSpec (файл-то есть), и дыра оставалась
+    — модуль «находится», но не импортируется. Настоящая проверка — попытка
+    импорта, как это делает importorskip.
+    """
+    import importlib
+
+    missing = []
+    for mod in SERVER_DEPS:
+        try:
+            importlib.import_module(mod)
+        except Exception:  # noqa: BLE001 — любой сбой импорта = «модуля нет»
+            missing.append(mod)
+    return missing
+
+
+def pytest_sessionstart(session):
+    """Гейт сервера ДО коллекции.
+
+    Именно до коллекции, а не фикстурой: `pytest.importorskip("playwright")`
+    в test_visual_snapshots.py выполняется на ИМПОРТЕ модуля, то есть раньше
+    любой фикстуры. Если playwright не установлен, тесты становятся skipped
+    ещё до того, как фикстура успела бы что-либо сделать.
+
+    Замечание к прежней версии этого docstring: здесь было написано, что хук
+    «ловит и этот случай». Не ловил. С подменённым numpy гейт возвращал run
+    (сервер-то был живой), а прогон давал 2 skipped и ноль выполненных
+    тестов. Поэтому проверка зависимостей вынесена в missing_server_deps() и
+    вызывается здесь же, а не «сама собой».
+    """
+    gates = active_server_gates()
+    if not gates:
+        return
+
+    base_url = os.environ.get("SNAPSHOT_BASE_URL", DEFAULT_BASE_URL).rstrip("/")
+    ci = is_ci()
+    allow_skip = env_flag("ALLOW_SERVER_SKIP")
+    missing = missing_server_deps()
+    reachable = False if missing else server_reachable(base_url)
+    verdict = server_gate_verdict(gates, reachable, ci, allow_skip)
+
+    if verdict == "fail":
+        listed = "\n".join(f"    {var} — {desc}" for var, desc in gates.items())
+        if missing:
+            reason = (
+                f"Включены тесты, требующие модулей, которых нет: "
+                f"{', '.join(missing)}.\n"
+                f"    Поставь: pip install -r requirements-dev.txt\n"
+                f"    playwright install chromium\n\n"
+                f"Без них importorskip помечает модуль пропущенным, прогон\n"
+                f"завершается кодом 0, и ни один пиксель не проверен.\n\n"
+            )
+        else:
+            reason = (
+                f"Включены тесты, требующие живого сервера, но {base_url} не "
+                f"отвечает ИЛИ отдаёт другую копию проекта:\n{listed}\n\n"
+                f"Без сервера эти тесты ПРОПУСКАЮТСЯ, а pytest завершается с "
+                f"кодом 0 —\nто есть отчёт был бы зелёным, хотя не проверен ни "
+                f"один пиксель.\nОтказываемся запускаться, чтобы это не "
+                f"выглядело как проверка.\n\n"
+            )
+
+        raise pytest.UsageError(
+            f"\n\n{reason}"
+            f"Что сделать:\n"
+            f"  * поднять сервер из КОРНЯ репозитория:\n"
+            f"        python -m http.server 8000 --directory docs\n"
+            f"  * или указать другой адрес:\n"
+            f"        $env:SNAPSHOT_BASE_URL=\"http://localhost:8020\"\n"
+            f"  * или снять гейт осознанно (прогон будет честно пустым):\n"
+            f"        $env:ALLOW_SERVER_SKIP=\"1\"\n\n"
+        )
+
+    if verdict == "skip":
+        detail = ", ".join(missing) if missing else base_url
+        print(
+            f"[server-gate] {detail} недоступно, но гейт снят "
+            f"(CI={ci}, ALLOW_SERVER_SKIP={allow_skip}) — тесты будут пропущены.",
+            file=sys.stderr,
+        )
+
+
+def pytest_terminal_summary(terminalreporter):
+    """Показать DuckDB-пропуски тем, кто их не выбирал.
+
+    Отдельная от :8000 проблема и другого класса: data/db/ в .gitignore, поэтому
+    brain.duckdb не бывает в CI, и тесты в test_sql.py и
+    test_integration_api_db.py не выполняются НИГДЕ, кроме машины, где кто-то
+    раз вручную выполнил scripts/db/import_to_duckdb.py. Молчаливый skip
+    выглядит как «проверено», поэтому печатаем это отдельной строкой.
+
+    Настоящее число пропусков берём из отчёта, а не константой: в тексте
+    стояло «16», а замер давал 18 — и «18» включало два e2e-пропуска, которые
+    к DuckDB отношения не имеют.
+    """
+    if DB_PATH.exists():
+        return
+    skipped = len(terminalreporter.stats.get("skipped", []))
+    plural = "тест" if skipped % 10 == 1 and skipped % 100 != 11 else "тестов"
+    terminalreporter.write_line(
+        f"ВНИМАНИЕ: {DB_PATH.name} нет — {skipped} {plural} SQL пропущено. "
+        f"data/db/ в .gitignore, поэтому в CI их не будет тоже. "
+        f"Создать: python scripts/db/import_to_duckdb.py",
+        yellow=True,
+    )
+
+
