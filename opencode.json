{
  "$schema": "https://opencode.ai/config.json",
  "shell": "pwsh",
  "lsp": {
    "pyright": {
      "command": ["pyright-langserver", "--stdio"]
    },
    "ts": {
      "command": ["typescript-language-server", "--stdio"]
    }
  },
  "mcp": {
    "servers": {
      "mcp-mermaid": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "mcp-mermaid"
        ]
      }
    }
  }
}