{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "nvidia/nemotron-3-ultra:free": { "name": "nemotron-ultra" },
        "google/gemma-4-31b-it:free": { "name": "gemma-31b" }
      }
    }
  }
}