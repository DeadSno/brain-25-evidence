{
  "info": {
    "_postman_id": "brain-25-evidence-v1",
    "name": "Brain 25 Evidence API v1",
    "description": "Публичный API открытой базы знаний о 130 БАД.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Meta",
      "item": [
        {
          "name": "GET index.json",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Type is application/json', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "pm.test('Response time < 1000 ms', () => pm.expect(pm.response.responseTime).to.be.below(1000));",
                  "const json = pm.response.json();",
                  "pm.test('Has required fields', () => { pm.expect(json).to.have.property('version'); pm.expect(json).to.have.property('count'); pm.expect(json).to.have.property('stats'); pm.expect(json).to.have.property('ids'); });",
                  "pm.test('Count = 130 supplements', () => pm.expect(json.count).to.eql(130));",
                  "pm.test('IDs array has 130 items', () => pm.expect(json.ids).to.be.an('array').with.lengthOf(130));",
                  "pm.test('Grades sum = 130', () => { const s = Object.values(json.stats.grades).reduce((a,b) => a+b, 0); pm.expect(s).to.eql(130); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/index.json",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "index.json"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Supplements",
      "item": [
        {
          "name": "GET supplements.json",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Type is application/json', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "pm.test('Response time < 2000 ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "const json = pm.response.json();",
                  "pm.test('Has 130 supplements', () => pm.expect(json.supplements).to.be.an('array').with.lengthOf(130));",
                  "pm.test('Count matches array length', () => pm.expect(json.count).to.eql(json.supplements.length));",
                  "pm.test('Each has id, grade, verdict', () => { json.supplements.forEach(s => { pm.expect(s).to.have.property('id'); pm.expect(s).to.have.property('grade'); pm.expect(s).to.have.property('verdict'); }); });",
                  "pm.test('Grade is A/B/C/D', () => { const v = ['A','B','C','D']; json.supplements.forEach(s => { if (s.grade) pm.expect(v).to.include(s.grade); }); });",
                  "pm.test('Verdict is valid', () => { const v = ['работает','зависит от контекста','не подтверждено']; json.supplements.forEach(s => { if (s.verdict) pm.expect(v).to.include(s.verdict); }); });",
                  "pm.test('scienceIndex is int', () => { json.supplements.forEach(s => { if (s.scienceIndex !== undefined) pm.expect(s.scienceIndex).to.be.a('number'); }); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/supplements.json",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "supplements.json"
              ]
            }
          }
        }
      ]
    }
  ]
}
